{
  "singleQuote": true,
  "printWidth": 120,
  "plugins": ["prettier-plugin-astro", "prettier-plugin-svelte"],
  "overrides": [
    {
      "files": "*.astro",
      "options": {
        "parser": "astro",
        "printWidth": 160
      }
    },
    {
      "files": "*.svelte",
      "options": {
        "parser": "svelte",
        "printWidth": 160
      }
    }
  ],
  "proseWrap": "never"
}

---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Pages with a board beside text use the wider column, header and footer included. */
  wide?: boolean;
}

const {
  title,
  wide = false,
  description = 'A free, offline strategy gym: learn to think ahead through chess and poker, against the computer. No money, no ratings.',
} = Astro.props;
const fullTitle = title === 'Chaalwise' ? title : `${title} · Chaalwise`;
const NAV = [
  ['/chess/', 'chess'],
  ['/chess/drills/', 'drills'],
  ['/review/', 'review'],
  ['/progress/', 'progress'],
];
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class:list={['wrap bar', { wide }]}>
        <a class="brand" href="/">
          chaal<span>wise</span>
        </a>
        <nav aria-label="Main">
          {NAV.map(([href, label]) => (
            <a href={href} aria-current={path === href ? 'page' : undefined}>
              {label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <div id="update" class="update" role="status" hidden>
      <span>A new version of Chaalwise is ready.</span>
      <button class="button" type="button">
        Reload
      </button>
    </div>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class:list={['wrap', { wide }]}>
        <p>Free, offline, and against the computer only. No money, no ratings. Your progress stays on this device.</p>
        <p>
          <a href="/credits/">credits</a> · <a href="https://github.com/urbanmorph/chaalwise">code</a> (AGPL-3.0) · made by{' '}
          <a href="https://www.urbanmorph.com/">urbanmorph</a> · <a href="https://github.com/urbanmorph/chaalwise/blob/main/PDGI.md">a digital commons</a> ·{' '}
          <a href="https://pdgi.org/">pdgi.org</a>
        </p>
      </div>
    </footer>
    <script src="../scripts/register-sw.ts"></script>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    min-height: 56px;
    flex-wrap: wrap;
  }
  .brand {
    font: 700 1.25rem/1 var(--sans);
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
  }
  .brand span {
    color: var(--accent-text);
  }
  nav {
    display: flex;
    gap: 4px;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 8px;
    color: var(--ink-2);
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }
  .update {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: center;
    padding: 10px 16px;
    background: var(--tint);
    border-bottom: 1px solid var(--rule);
  }
  .update[hidden] {
    display: none;
  }
  main {
    display: block;
    min-height: 60vh;
    padding-block: 32px 64px;
  }
  main:focus {
    outline: none;
  }
  .site-footer {
    margin-top: 48px;
    padding-block: 20px 32px;
    border-top: 1px solid var(--rule);
    color: var(--ink-2);
    font-size: 0.8125rem;
    line-height: 1.7;
  }
  .site-footer a {
    color: var(--ink-2);
    text-underline-offset: 2px;
  }
  .site-footer a:hover {
    color: var(--ink);
  }
</style>

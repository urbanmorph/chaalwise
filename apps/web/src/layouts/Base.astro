---
import '../styles/global.css';
import '../components/poker/poker.css';
import favicon from '../../public/favicon.svg?raw';

interface Props {
  title: string;
  description?: string;
  /** Pages with a board beside text use the wider column, header and footer included. */
  wide?: boolean;
  /** The learner's own pages, and the not-found page: kept out of search. */
  noindex?: boolean;
  /** Structured data for search engines (lib/seo.ts); a single item gets this page's address. */
  schema?: Record<string, unknown>;
}

const {
  title,
  wide = false,
  noindex = false,
  schema,
  description = 'Free, short lessons in strategy and decision-making, shown in chess and poker and used at work and in study. Offline, with no account and no money.',
} = Astro.props;
const fullTitle = title === 'Chaalwise' ? title : `${title} · Chaalwise`;
// What a link preview shows: the page's own title and description, on one share card for the site (scripts/og-image.mjs).
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const card = new URL('/og.png', Astro.site).href;
const jsonLd = schema && JSON.stringify(schema['@graph'] ? schema : { ...schema, url: pageUrl });
// Strategy first, then each game from its first lesson, for a beginner who only wants to learn chess or poker. A page marks the section it is in.
const NAV = [
  ['/skills/', 'strategy'],
  ['/chess/', 'chess'],
  ['/poker/', 'poker'],
  ['/daily/', 'daily'],
  ['/review/', 'review'],
  ['/progress/', 'progress'],
] as const;
const path = Astro.url.pathname;
// The mark (a knight's move on a small board), the same artwork as the favicon, drawn inline beside the wordmark.
const mark = favicon.replace('<svg ', '<svg class="mark" aria-hidden="true" focusable="false" ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={pageUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Chaalwise" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={card} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Chaalwise: think a move ahead. Free, short lessons in strategy." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class:list={['wrap bar', { wide }]}>
        <a class="brand" href="/">
          <Fragment set:html={mark} />
          <span class="word">
            chaal<span>wise</span>
          </span>
        </a>
        <button class="menu-toggle" type="button" popovertarget="site-nav">
          <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
            <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          Menu
        </button>
        <nav aria-label="Main" id="site-nav" popover>
          {NAV.map(([href, label]) => (
            <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>
              {label}
            </a>
          ))}
          <!-- Shown only where this browser can install Chaalwise (scripts/install-app.ts). -->
          <button id="install-app" class="install" type="button" hidden>
            Install app
          </button>
        </nav>
      </div>
    </header>
    <div id="update" class="update" role="status" hidden>
      <span>A new version of Chaalwise is ready.</span>
      <button class="button" type="button">
        Reload
      </button>
    </div>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class:list={['wrap', { wide }]}>
        <p>Free, offline, and against the computer only. No money, no ratings. Your progress stays on this device.</p>
        <p>
          <a href="/reference/">reference</a> · <a href="https://github.com/urbanmorph/chaalwise/blob/main/CREDITS.md">credits</a> ·{' '}
          <a href="https://github.com/urbanmorph/chaalwise">code</a> (AGPL-3.0) · made by <a href="https://www.urbanmorph.com/">urbanmorph</a> ·{' '}
          <a href="https://github.com/urbanmorph/chaalwise/blob/main/TERMS.md">terms</a>
        </p>
      </div>
    </footer>
    <dialog id="install-guide" class="install-guide" aria-labelledby="install-guide-title">
      <h2 id="install-guide-title">Add Chaalwise to your Home Screen</h2>
      <ol>
        <li>
          Tap the <strong>Share</strong> button <span aria-hidden="true">(the square with an arrow)</span> in Safari's toolbar.
        </li>
        <li>
          Scroll down and tap <strong>Add to Home Screen</strong>.
        </li>
        <li>
          Tap <strong>Add</strong>.
        </li>
      </ol>
      <form method="dialog">
        <button class="button primary">OK</button>
      </form>
    </dialog>
    <script src="../scripts/register-sw.ts"></script>
    <script src="../scripts/install-app.ts"></script>
  </body>
</html>

<style>
  .site-header {
    /* Below the notch or status bar when the page fills the screen. */
    padding-top: env(safe-area-inset-top);
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    min-height: 56px;
    flex-wrap: wrap;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 700 1.25rem/1 var(--sans);
    letter-spacing: -0.02em;
    color: var(--ink);
    text-decoration: none;
  }
  .word span {
    color: var(--accent-text);
  }
  .brand :global(.mark) {
    width: 26px;
    height: 26px;
    flex: none;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 4px;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 8px;
    color: var(--ink-2);
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }
  nav .install {
    margin-left: 8px;
  }
  /*
   * On a phone the links fold behind a Menu button: the nav is a popover, so the
   * browser opens and closes it, with Escape and a tap outside, and no script.
   * Where popovers are not supported, the button stays hidden and every link shows.
   */
  .menu-toggle {
    display: none;
  }
  nav[popover] {
    position: static;
    inset: auto;
    width: auto;
    height: auto;
    margin: 0;
    padding: 0;
    overflow: visible;
    border: 0;
    background: none;
    color: inherit;
  }
  @media (max-width: 759px) {
    @supports selector(:popover-open) {
      .menu-toggle {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 44px;
        padding: 0 14px;
        border: 1px solid var(--rule-strong);
        border-radius: 999px;
        background: transparent;
        color: var(--ink);
        font: 600 0.9375rem var(--sans);
        cursor: pointer;
      }
      nav[popover]:not(:popover-open) {
        display: none;
      }
      nav[popover]:popover-open {
        position: fixed;
        inset: calc(57px + env(safe-area-inset-top)) 0 auto;
        flex-direction: column;
        padding: 4px var(--gutter-right) 16px var(--gutter-left);
        border-bottom: 1px solid var(--rule);
        background: var(--paper);
        box-shadow: var(--shadow);
      }
      nav[popover]:popover-open a {
        padding: 0;
      }
      nav[popover]:popover-open .install {
        align-self: flex-start;
        margin: 8px 0 0;
      }
    }
  }
  .update {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: center;
    padding: 10px var(--gutter-right) 10px var(--gutter-left);
    background: var(--tint);
    border-bottom: 1px solid var(--rule);
  }
  .update[hidden] {
    display: none;
  }
  main {
    display: block;
    min-height: 60vh;
    padding-block: 32px 64px;
  }
  main:focus {
    outline: none;
  }
  .site-footer {
    margin-top: 48px;
    /* Above the home indicator when the page fills the screen. */
    padding-block: 20px calc(32px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--rule);
    color: var(--ink-2);
    font-size: 0.8125rem;
    line-height: 1.7;
  }
  .site-footer a {
    color: var(--ink-2);
    text-underline-offset: 2px;
  }
  .site-footer a:hover {
    color: var(--ink);
  }
  .install {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: 600 0.875rem var(--sans);
    cursor: pointer;
  }
  .install:hover {
    background: var(--card);
  }
  .install[hidden] {
    display: none;
  }
  .install-guide {
    width: min(26rem, calc(100% - 32px));
    padding: 24px;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--shadow);
  }
  .install-guide::backdrop {
    background: rgb(10 10 10 / 0.5);
  }
  .install-guide h2 {
    font-size: 1.25rem;
  }
  .install-guide ol {
    margin: 0 0 20px;
    padding-left: 1.25em;
  }
  .install-guide li + li {
    margin-top: 6px;
  }
  .install-guide form {
    display: flex;
    justify-content: flex-end;
  }
</style>

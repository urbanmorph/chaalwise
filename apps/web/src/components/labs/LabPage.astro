---
import { withContext } from '../../lib/seo';
import { SKILLS } from '@chaalwise/core/skills';
import Base from '../../layouts/Base.astro';
import { entryHref } from '../../lib/reference';
import { referenceEntries } from '../../lib/reference-entries';
import type { Lab } from '../../lib/labs/labs';
import { LAB_PLANS } from '../../lib/labs/plans';
import { ask } from '../../lib/questions';
import { labLessons, lessonHref } from '../../lib/lessons';
import Reflection from '../Reflection.svelte';
import TryIt from '../TryIt.astro';
import LabPlan from './LabPlan.svelte';
import './labs.css';

/**
 * A game-theory lab: the idea, the game (the slot, an island), then the
 * debrief questions from the lab's reference entry, a plan to use the idea this
 * week and an optional reflection, the lessons on its skill and where to read more.
 */
interface Props {
  lab: Lab;
}

const { lab } = Astro.props;
const all = await referenceEntries();
const find = (id: string) => {
  const entry = all.find((e) => e.id === id);
  if (!entry) throw new Error(`lab ${lab.slug}: no reference entry ${id}`);
  return entry;
};
const entry = find(lab.entry);
const read = [entry, ...lab.read.map(find)];
if (!entry.data.try) throw new Error(`lab ${lab.slug}: ${lab.entry} has no questions to try`);
const steps = await ask(entry.data.try);
const track = SKILLS[lab.track];
const lessons = await labLessons(lab);
const plan = LAB_PLANS[lab.slug];
if (!plan) throw new Error(`lab ${lab.slug}: no plan in LAB_PLANS`);
---

<Base title={`${lab.title} lab`} description={withContext(lab.idea, 'A five-minute lab against the computer.')}>
  <div class="wrap">
    <p class="crumb">
      <a href="/labs/">Labs</a>
    </p>
    <h1>{lab.title}</h1>
    <p class="idea">{lab.idea}</p>
    <p class="label">5 minutes · trains {track} · points only, never money</p>
    <slot />
    <TryIt {steps} more={{ href: `/skills/${lab.track}/`, label: `Practise ${track}` }} />
    <section class="plan" aria-labelledby="plan-title" data-testid="lab-plan">
      <h2 id="plan-title">Use it this week</h2>
      <p class="prompt">{plan.prompt}</p>
      <LabPlan client:idle slug={lab.slug} track={lab.track} {plan} />
      <Reflection client:idle from={`labs/${lab.slug}`} title={lab.title} />
    </section>
    {lessons.length > 0 && (
      <section class="lessons" aria-labelledby="lessons-title">
        <h2 id="lessons-title">Lessons on this skill</h2>
        <ul>
          {lessons.map((l) => (
            <li>
              <a href={lessonHref(l)}>{l.data.title}</a>{' '}
              <span>
                {l.data.game === 'poker' ? 'Poker lesson. ' : ''}
                {l.data.summary}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )}
    <section class="read">
      <h2>Read more</h2>
      <ul>
        {read.map((e) => (
          <li>
            <a href={entryHref(e.id)}>{e.data.term}</a> <span>{e.data.summary}</span>
          </li>
        ))}
        <li>
          <a href={`/skills/${lab.track}/`}>The {track} course</a> <span>Lessons and practice for the skill this lab trains.</span>
        </li>
      </ul>
    </section>
  </div>
</Base>

<style>
  .crumb {
    margin-bottom: 4px;
  }
  .idea {
    font-size: 1.2rem;
  }
  .plan,
  .lessons,
  .read {
    margin-top: 32px;
  }
  .plan {
    padding-top: 24px;
    border-top: 2px solid var(--ink);
  }
  .plan .prompt {
    font-size: 1.2rem;
    font-weight: 600;
  }
  .lessons ul,
  .read ul {
    padding-left: 1.2em;
  }
  .lessons li,
  .read li {
    margin-bottom: 6px;
  }
  .lessons span,
  .read span {
    color: var(--ink-2);
  }
</style>

---
import { lessonHref, lessonPath } from '../lib/lessons';

/**
 * The home page's one way in. Drawn at build time for a new learner: the first
 * strategy lesson. Once this device has answers, the script points the same
 * button at the learner's next focus, so there is never a second start button
 * and the page does not jump. Plain script, so the home page stays light.
 */
const first = (await lessonPath()).find((l) => l.data.game === 'strategy')!;
---

<div class="actions" data-testid="home-next-focus">
  <a class="button primary" href={lessonHref(first)}>
    Start the first lesson
  </a>
  <a class="button" href="#skills">
    See the skills
  </a>
</div>

<script>
  import { openProgress } from '@chaalwise/core/progress';
  import { buildProfile } from '../lib/profile';

  const start = document.querySelector<HTMLAnchorElement>('[data-testid="home-next-focus"] .primary');
  openProgress()
    .then(async (progress) => {
      const attempts = await progress.attemptsBySkill();
      progress.close();
      // A new learner keeps the first strategy lesson drawn at build time.
      if (!start || !Object.keys(attempts).length) return;
      const { focus } = buildProfile(attempts);
      if (!focus) return;
      start.href = focus.skill.practise.href;
      start.textContent = `Your next focus: ${focus.skill.name}`;
    })
    .catch(console.error);
</script>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
</style>

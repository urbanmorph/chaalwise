---
import { buildProfile } from '../lib/profile';

/**
 * "Next focus" on the home page. It is drawn at build time for a new learner
 * (board sense), and the script swaps in this device's focus in place, so the
 * page never jumps. Plain script, so the home page stays light.
 */
const { focus } = buildProfile({});
---

<section class="card next-focus" data-testid="home-next-focus">
  <p class="label">Your next focus</p>
  <h2>{focus?.skill.name}</h2>
  <p class="means">{focus?.skill.means}</p>
  <a class="button primary" href={focus?.skill.practise.href}>
    Practise: {focus?.skill.practise.label}
  </a>
</section>

<script>
  import { openProgress } from '@chaalwise/core/progress';
  import { buildProfile } from '../lib/profile';

  const card = document.querySelector<HTMLElement>('.next-focus');
  openProgress()
    .then(async (progress) => {
      const attempts = await progress.attemptsBySkill();
      progress.close();
      // A new learner keeps the board-sense card drawn at build time.
      if (!card || !Object.keys(attempts).length) return;
      const { focus } = buildProfile(attempts);
      if (!focus) return;
      card.querySelector('h2')!.textContent = focus.skill.name;
      card.querySelector('.means')!.textContent = `${focus.skill.means} ${focus.assessment.level === 'not-started' ? '' : focus.assessment.reason}`.trim();
      const link = card.querySelector('a')!;
      link.href = focus.skill.practise.href;
      link.textContent = `Practise: ${focus.skill.practise.label}`;
    })
    .catch(console.error);
</script>

<style>
  .next-focus {
    border-left: 4px solid var(--accent);
    margin-top: 28px;
  }
  .next-focus h2 {
    margin-bottom: 6px;
  }
  .means {
    color: var(--ink-2);
  }
</style>

---
import { lessonHref, lessonPath, STAGES } from '../lib/lessons';

/**
 * The whole path beside a lesson: every stage folded except the one you are in,
 * so the rail needs no scroll box of its own. Strategy lessons sit in place; this
 * lesson is marked.
 */
interface Props {
  current: string;
}

const { current } = Astro.props;
const path = await lessonPath();
const stages = [...new Set(path.map((l) => l.data.stage))];
---

<nav class="rail" aria-label="All lessons">
  {stages.map((stage) => {
    const lessons = path.filter((l) => l.data.stage === stage);
    return (
      <details open={lessons.some((l) => l.id === current)}>
        <summary>
          <span class="label">
            Stage {stage} · {STAGES[stage]}
          </span>
          <span class="count">{lessons.length}</span>
        </summary>
        <ol>
          {lessons.map((l) => (
            <li data-lesson={l.id} class:list={{ strategy: l.data.game === 'strategy' }}>
              <a href={lessonHref(l)} aria-current={l.id === current ? 'page' : undefined}>
                {l.data.title}
              </a>
            </li>
          ))}
        </ol>
      </details>
    );
  })}
</nav>

<script>
  import { markDone } from '../scripts/mark-done';

  markDone().catch(console.error);
</script>

<style>
  details + details {
    margin-top: 4px;
  }
  summary {
    display: flex;
    gap: 8px;
    align-items: baseline;
    padding: 6px 0;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::before {
    content: '▸';
    color: var(--ink-2);
    transition: transform 0.15s;
  }
  details[open] > summary::before {
    transform: rotate(90deg);
  }
  summary:hover .label {
    color: var(--ink);
  }
  .count {
    margin-left: auto;
    color: var(--ink-2);
    font-size: 0.85rem;
  }
  details[open] > ol {
    margin-bottom: 12px;
  }
  @media (prefers-reduced-motion: reduce) {
    summary::before {
      transition: none;
    }
  }
  ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2px;
  }
  li a {
    display: flex;
    gap: 8px;
    align-items: baseline;
    padding: 6px 8px 6px 10px;
    border-left: 2px solid var(--rule);
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.9rem;
    line-height: 1.35;
  }
  li a:hover {
    color: var(--ink);
    background: var(--tint);
  }
  li.strategy a {
    padding-left: 22px;
    font-style: italic;
  }
  /* A finished lesson gets a tick; drawn in CSS so screen readers hear only the title and "done". */
  li.done a::after {
    content: '✓';
    margin-left: auto;
    color: var(--pass);
    font-style: normal;
  }
  li a[aria-current='page'] {
    border-left-color: var(--accent);
    color: var(--ink);
    font-weight: 600;
    background: var(--tint);
  }
</style>

---
import type { GradedStep } from '@chaalwise/core/lesson';
import { toFen } from '../lib/chess';
import Diagram from './Diagram.astro';

/**
 * "Try it yourself" on a reference entry: the first question drawn at build
 * time, and the live board loaded only when the learner asks, so the page stays
 * a light reading page.
 */
interface Props {
  /** The entry, such as `strategy/weakest-link`. */
  entry: string;
  steps: GradedStep[];
  /** The skill the answers count towards. */
  measures?: string | undefined;
  /** Where to practise more of the same. */
  more?: { href: string; label: string } | undefined;
}

const { entry, steps, measures, more } = Astro.props;
const first = steps[0]!;
const count = steps.length === 1 ? 'One question' : `${steps.length} questions`;
---

<section class="try" aria-labelledby="try-title">
  <h2 id="try-title">Try it yourself</h2>
  <div class="stage" data-entry={entry} data-steps={JSON.stringify(steps)} data-measures={measures}>
    <div class:list={['preview', { 'has-board': first.position }]}>
      {first.position && (
        <div class="board">
          <Diagram fen={toFen(first.position)} orientation={first.kind === 'choice' ? undefined : first.orientation} label="The board for the first question" />
        </div>
      )}
      <div class="ask">
        <p class="prompt">{first.prompt}</p>
        <button class="button primary" type="button">
          Try it
        </button>
        <p class="count">{count}, a minute or two. Nothing to finish first.</p>
      </div>
    </div>
  </div>
  {more && (
    <p class="more">
      Want more? <a href={more.href}>{more.label}</a>.
    </p>
  )}
</section>

<script>
  for (const stage of document.querySelectorAll<HTMLElement>('.try .stage')) {
    const button = stage.querySelector('button')!;
    button.addEventListener('click', async () => {
      button.disabled = true;
      try {
        const { mountTry } = await import('../lib/try-it');
        mountTry(stage, stage.dataset.entry!, JSON.parse(stage.dataset.steps!), stage.dataset.measures);
      } catch (error) {
        // Offline before the board was ever loaded: let the learner try again later.
        console.error(error);
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .try {
    margin-top: 32px;
    padding-top: 24px;
    border-top: 2px solid var(--ink);
  }
  .preview {
    display: grid;
    gap: 16px 32px;
    align-items: start;
  }
  @media (min-width: 760px) {
    .preview.has-board {
      grid-template-columns: minmax(0, 420px) minmax(0, 1fr);
    }
  }
  .prompt {
    font-size: 1.2rem;
    font-weight: 600;
  }
  .count,
  .more {
    color: var(--ink-2);
  }
  .more {
    margin-top: 16px;
  }
</style>

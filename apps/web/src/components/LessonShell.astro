---
import { courseOf, type LessonEntry } from '../lib/lessons';
import { entryHref } from '../lib/reference';
import { entriesForLesson } from '../lib/reference-entries';
import LessonArticle from './LessonArticle.astro';
import LessonRail from './LessonRail.astro';

/** A lesson page: the lesson, and the whole path in a rail beside it (below it on narrow screens). */
interface Props {
  lesson: LessonEntry;
}

const { lesson } = Astro.props;
const lookUp = await entriesForLesson(lesson.id);
---

<div class="wrap wide shell">
  <article>
    <slot name="crumb" />
    <LessonArticle {lesson} />
    {lookUp.length > 0 && (
      <nav class="look-up" aria-label="In the reference">
        <h2>Look it up</h2>
        <ul>
          {lookUp.map((e) => (
            <li>
              <a href={entryHref(e.id)}>{e.data.term}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </article>
  <aside>
    <LessonRail current={lesson.id} course={courseOf(lesson)} />
  </aside>
</div>

<style>
  .look-up {
    margin-top: 40px;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
  }
  .look-up h2 {
    font-size: 1.1rem;
  }
  .look-up ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    padding: 0;
    list-style: none;
  }
  .shell {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 1180px) {
    .shell {
      grid-template-columns: minmax(0, 1fr) 250px;
      align-items: start;
    }
  }
  @media (max-width: 1179px) {
    aside {
      border-top: 1px solid var(--rule);
      padding-top: 24px;
    }
  }
</style>

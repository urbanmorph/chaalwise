---
import { render } from 'astro:content';
import { DONE_KEY } from '../lib/done-lessons';
import { COURSE_HOME, courseOf, lessonHref, lessonPath, pathContext, playedSteps, type LessonEntry } from '../lib/lessons';
import { RESUME_KEY } from '../lib/resume';
import LessonPage from './LessonPage.svelte';
import MoreOnLichess from './MoreOnLichess.astro';
import { LICHESS_LESSONS } from '../lib/lichess';
import { meetFirst } from '../lib/games';
import { labHref, LABS, labsForLesson } from '../lib/labs/labs';
import TryTheLab from './TryTheLab.astro';

/** A lesson page's body, shared by chess and strategy lessons: intro, player, and a note if it builds on unfinished earlier stages. */
interface Props {
  lesson: LessonEntry;
}

const { lesson } = Astro.props;
const { Content } = await render(lesson);
const { next, buildsOn } = await pathContext(lesson);
const steps = await playedSteps(lesson);
const firstChess = (await lessonPath()).find((l) => l.data.game === 'chess')!;
// Meet the game first: a strategy lesson's chess, poker and lab questions are worked examples until that game is met.
const meet = meetFirst(lesson.data, steps);
const firstLab = LABS.find((l) => meet.includes(`labs/${l.slug}`));
const { game, skills } = lesson.data;
// Any strategy lesson with a board writes chess moves, so it carries the key to them.
const movesWritten = lesson.data.game === 'strategy' && steps.some((s) => 'position' in s && s.position);
const earlier = buildsOn.map((l) => ({ id: l.id, href: lessonHref(l), title: l.data.title }));
---

<p class="builds-on" hidden></p>
{/* Inline, so it runs before the first paint and the lesson never jumps: it reads the quick copy of finished lessons. */}
<script is:inline define:vars={{ earlier, key: DONE_KEY }}>
  (() => {
    let done = [];
    try {
      done = JSON.parse(localStorage.getItem(key) ?? '[]');
    } catch {
      // Storage can be blocked: treat it as a new learner.
    }
    const first = earlier.find((l) => !done.includes(l.id));
    const note = document.currentScript.previousElementSibling;
    if (!first) return;
    const link = Object.assign(document.createElement('a'), { href: first.href, textContent: first.title });
    note.append('This builds on earlier lessons you have not done yet. You can carry on, or start with ', link, '.');
    note.hidden = false;
  })();
</script>
<h1>{lesson.data.title}</h1>
{meet.includes('chess') && (
  <p class="meet" data-meet="chess" data-testid="meet-chess" hidden>
    This lesson uses chess positions. Until you have played a little, its board questions are worked examples to read. New to chess?{' '}
    <a href="/chess/first-moves/">Play your first moves</a> (five minutes), then <a href={lessonHref(firstChess)}>learn it from the beginning</a>.
  </p>
)}
{meet.includes('poker') && (
  <p class="meet" data-meet="poker" data-testid="meet-poker" hidden>
    This lesson uses poker hands. Until you have played a few, its poker questions are worked examples to read. New to poker?{' '}
    <a href="/poker/first-hands/">Play your first hands</a>, with a coach at every decision. Practice points only.
  </p>
)}
{firstLab && (
  <p class="meet" data-meet={`labs/${firstLab.slug}`} data-testid="meet-lab" hidden>
    This lesson starts from the {firstLab.title} lab, a game of about five minutes against the computer. Until you have played it, its questions about the lab
    are worked examples to read. <a href={labHref(firstLab)}>Play the {firstLab.title} lab first</a>.
  </p>
)}
{/* Inline, so the notes show before the first paint and the lesson never jumps. A game is met as in lib/games (gamesMet). */}
{meet.length > 0 && <script is:inline define:vars={{ key: DONE_KEY }}>
  (() => {
    let done = [];
    try {
      done = JSON.parse(localStorage.getItem(key) ?? '[]');
    } catch {
      // Storage can be blocked: treat it as a new learner.
    }
    for (const note of document.querySelectorAll('[data-meet]')) {
      const game = note.dataset.meet;
      note.hidden = game.startsWith('labs/') ? done.includes(game) : done.some((id) => id.startsWith(`${game}/`));
    }
  })();
</script>}
{movesWritten && (
  <p class="notation-key">
    Chess moves are written short: K king, Q queen, R rook, B bishop, N knight, no letter for a pawn, then the square the piece moves to. x means it takes, +
    means check. See <a href="/chess/notation/">how moves are written</a>.
  </p>
)}
<div class="intro">
  <Content />
</div>
<LessonPage
  client:load
  lesson={{ steps }}
  lessonId={lesson.id}
  next={next && { href: lessonHref(next), title: next.data.title }}
  track={game === 'chess' ? undefined : skills[0]}
  all={COURSE_HOME[courseOf(lesson)]}
  checkable={game === 'chess'}
  meetFirst={meet}
/>
<TryTheLab labs={labsForLesson(lesson.data)} />
<MoreOnLichess link={LICHESS_LESSONS[lesson.id]} />
{/* Inline, so the offer to carry on shows before the first paint and the lesson never jumps. LessonPage checks the place again (readResume). */}
<script is:inline define:vars={{ key: RESUME_KEY, id: lesson.id, ids: steps.map((s) => s.id) }}>
  (() => {
    let left;
    try {
      left = JSON.parse(localStorage.getItem(key) ?? '{}')[id];
    } catch {
      // Storage can be blocked: the lesson starts from the beginning.
    }
    if (!left || !(left.index > 0 || Object.keys(left.outcomes ?? {}).length) || ids[left.index] !== left.step) return;
    const offer = document.querySelector('[data-resume]');
    offer.querySelector('[data-resume-step]').textContent = left.index + 1;
    offer.hidden = false;
  })();
</script>

<style>
  .builds-on {
    padding: 10px 14px;
    border-left: 3px solid var(--accent);
    background: var(--tint);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .builds-on[hidden],
  .notation-key {
    color: var(--ink-2);
    font-size: 0.9rem;
  }
  .meet[hidden] {
    display: none;
  }
  .meet {
    padding: 10px 14px;
    border-left: 3px solid var(--accent);
    background: var(--tint);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .intro {
    font-size: 1.05rem;
    color: var(--ink-2);
    margin-bottom: 24px;
  }
</style>

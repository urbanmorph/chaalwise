---
import { render } from 'astro:content';
import { DONE_KEY } from '../lib/done-lessons';
import { lessonHref, pathContext, playedSteps, type LessonEntry } from '../lib/lessons';
import LessonPage from './LessonPage.svelte';
import NewToChess from './NewToChess.astro';

/** A lesson page's body, shared by chess and strategy lessons: intro, player, and a note if it builds on unfinished earlier stages. */
interface Props {
  lesson: LessonEntry;
}

const { lesson } = Astro.props;
const { Content } = await render(lesson);
const { next, buildsOn } = await pathContext(lesson);
const steps = await playedSteps(lesson);
const earlier = buildsOn.map((l) => ({ id: l.id, href: lessonHref(l), title: l.data.title }));
---

<p class="builds-on" hidden></p>
{/* Inline, so it runs before the first paint and the lesson never jumps: it reads the quick copy of finished lessons. */}
<script is:inline define:vars={{ earlier, key: DONE_KEY }}>
  (() => {
    let done = [];
    try {
      done = JSON.parse(localStorage.getItem(key) ?? '[]');
    } catch {
      // Storage can be blocked: treat it as a new learner.
    }
    const first = earlier.find((l) => !done.includes(l.id));
    const note = document.currentScript.previousElementSibling;
    if (!first) return;
    const link = Object.assign(document.createElement('a'), { href: first.href, textContent: first.title });
    note.append('This builds on earlier lessons you have not done yet. You can carry on, or start with ', link, '.');
    note.hidden = false;
  })();
</script>
<h1>{lesson.data.title}</h1>
<div class="intro">
  <Content />
</div>
{lesson.data.game === 'strategy' && <NewToChess />}
<LessonPage
  client:load
  lesson={{ steps }}
  lessonId={lesson.id}
  next={next && { href: lessonHref(next), title: next.data.title }}
  track={lesson.data.game === 'strategy' ? lesson.data.skills[0] : undefined}
  checkable={lesson.data.game === 'chess'}
/>

<style>
  .builds-on {
    padding: 10px 14px;
    border-left: 3px solid var(--accent);
    background: var(--tint);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .builds-on[hidden] {
    display: none;
  }
  .intro {
    font-size: 1.05rem;
    color: var(--ink-2);
    margin-bottom: 24px;
  }
</style>

---
import MixedPractice from '../components/MixedPractice.svelte';
import PlanCheckIn from '../components/PlanCheckIn.svelte';
import ReviewSession from '../components/ReviewSession.svelte';
import Base from '../layouts/Base.astro';
import { reviewSteps } from '../lib/lessons';

const steps = await reviewSteps();
---

<Base title="Review" description="Today's spaced-repetition review." wide noindex>
  <div class="wrap wide">
    <h1>Today's review</h1>
    <ReviewSession client:load {steps} />
    <MixedPractice client:idle {steps} />
    {/* Below the review, so it never pushes the questions down as it loads. */}
    <PlanCheckIn client:idle />
  </div>
</Base>

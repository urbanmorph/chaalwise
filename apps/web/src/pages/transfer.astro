---
import Base from '../layouts/Base.astro';

const SOURCES = [
  {
    cite: 'Sala, G. & Gobet, F. (2016). Do the benefits of chess instruction transfer to academic and cognitive skills? A meta-analysis. Educational Research Review, 18.',
    href: 'https://doi.org/10.1016/j.edurev.2016.02.002',
  },
  {
    cite: 'Sala, G. & Gobet, F. (2017). Does far transfer exist? Negative evidence from chess, music, and working memory training. Current Directions in Psychological Science, 26(6).',
    href: 'https://doi.org/10.1177/0963721417712760',
  },
  {
    cite: 'Jerrim, J. et al. (2018). Does teaching children how to play cognitively demanding games improve their educational attainment? Evidence from a randomised controlled trial of chess instruction in England. Journal of Human Resources, 53(4).',
    href: 'https://doi.org/10.3368/jhr.53.4.0516.7952R',
  },
  {
    cite: 'Barnett, S. M. & Ceci, S. J. (2002). When and where do we apply what we learn? A taxonomy for far transfer. Psychological Bulletin, 128(4).',
    href: 'https://doi.org/10.1037/0033-2909.128.4.612',
  },
  {
    cite: 'Perkins, D. N. & Salomon, G. (1988). Teaching for transfer. Educational Leadership, 46(1).',
    href: 'https://www1.udel.edu/dssep/transfer/teaching_for_transfer.htm',
  },
  {
    cite: 'Gentner, D., Loewenstein, J. & Thompson, L. (2003). Learning and transfer: a general role for analogical encoding. Journal of Educational Psychology, 95(2).',
    href: 'https://doi.org/10.1037/0022-0663.95.2.393',
  },
  {
    cite: 'Bisra, K. et al. (2018). Inducing self-explanation: a meta-analysis. Educational Psychology Review, 30.',
    href: 'https://doi.org/10.1007/s10648-018-9434-x',
  },
  {
    cite: 'Morewedge, C. K. et al. (2015). Debiasing decisions: improved decision making with a single training intervention. Policy Insights from the Behavioral and Brain Sciences, 2(1).',
    href: 'https://doi.org/10.1177/2372732215600886',
  },
  {
    cite: 'Sellier, A.-L., Scopelliti, I. & Morewedge, C. K. (2019). Debiasing training improves decision making in the field. Psychological Science, 30(9).',
    href: 'https://doi.org/10.1177/0956797619861429',
  },
  {
    cite: 'Gollwitzer, P. M. & Sheeran, P. (2006). Implementation intentions and goal achievement: a meta-analysis. Advances in Experimental Social Psychology, 38.',

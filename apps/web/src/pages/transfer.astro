    font-size: 1.15rem;
    color: var(--ink-2);
  }
  section {
    margin-top: 36px;
  }
  ul {
    padding-left: 20px;
  }
  li {
    margin-bottom: 10px;
  }
  .sources {
    padding-left: 20px;
    color: var(--ink-2);
    font-size: 0.9rem;
  }
  .sources a {
    overflow-wrap: anywhere;
  }
</style>

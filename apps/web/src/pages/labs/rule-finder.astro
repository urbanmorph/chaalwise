---
import LabPage from '../../components/labs/LabPage.astro';
import RuleFinderLab from '../../components/labs/RuleFinderLab.svelte';
import { LABS } from '../../lib/labs/labs';

const lab = LABS.find((l) => l.slug === 'rule-finder')!;
---

<LabPage {lab}>
  <p>
    A hidden rule says yes or no to any three whole numbers. You see three numbers that fit it. First, pick the rule you think it is from the list. Then type
    three numbers of your own and press Test to see if they fit. When you are sure, press "That is the rule". You score a rule found when your pick is right.
    Three rounds, each with a different rule.
  </p>
  <RuleFinderLab client:load />
</LabPage>

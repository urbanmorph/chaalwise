---
import CoordinationLab from '../../components/labs/CoordinationLab.svelte';
import LabPage from '../../components/labs/LabPage.astro';
import { LABS } from '../../lib/labs/labs';

const lab = LABS.find((l) => l.slug === 'pick-the-same')!;
---

<LabPage {lab}>
  <p>
    Sometimes everyone does better by choosing the same thing as everyone else, and the hard part is guessing what the others will choose. First, try to pick
    the same as a crowd of bots, with no way to talk. Then hunt a stag (a large deer) with four bots who trust in different ways. You catch it only if all five
    of you go for it.
  </p>
  <CoordinationLab client:load />
</LabPage>

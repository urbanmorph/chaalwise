---
import CoordinationLab from '../../components/labs/CoordinationLab.svelte';
import LabPage from '../../components/labs/LabPage.astro';
import { LABS } from '../../lib/labs/labs';

const lab = LABS.find((l) => l.slug === 'pick-the-same')!;
---

<LabPage {lab}>
  <p>
    Sometimes everyone does better by choosing the same thing as everyone else, and the hard part is guessing what the others will choose. First, meet a crowd
    of bots without a word. Then hunt a stag with four bots who trust in different ways.
  </p>
  <CoordinationLab client:load />
</LabPage>

---
import DilemmaLab from '../../components/labs/DilemmaLab.svelte';
import LabPage from '../../components/labs/LabPage.astro';
import { noisyPair, styleTable } from '../../lib/labs/dilemma';
import { LABS } from '../../lib/labs/labs';

const lab = LABS.find((l) => l.slug === 'prisoners-dilemma')!;
---

<LabPage {lab}>
  <p>Taking advantage of a bot that works with you scores the most in a single round. But the game goes on for many rounds, and the bot remembers.</p>
  <DilemmaLab client:load styles={styleTable()} noisy={noisyPair()} />
</LabPage>

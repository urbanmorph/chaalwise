---
import AuctionLab from '../../components/labs/AuctionLab.svelte';
import LabPage from '../../components/labs/LabPage.astro';
import { LABS } from '../../lib/labs/labs';

const lab = LABS.find((l) => l.slug === 'sealed-bid-auction')!;
---

<LabPage {lab}>
  <p>
    Five jars of coins come up for auction, one at a time. You and four bots each make one secret (sealed) bid on each jar, from a rough estimate of what it
    holds. Try to end with more points than you started with.
  </p>
  <AuctionLab client:load />
</LabPage>

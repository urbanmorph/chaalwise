---
import { lessonSchema } from '../../lib/seo';
import LessonShell from '../../components/LessonShell.astro';
import Base from '../../layouts/Base.astro';
import { chessLessons, STAGES, type LessonEntry } from '../../lib/lessons';

export async function getStaticPaths() {
  return (await chessLessons()).map((lesson) => ({ params: { slug: lesson.id.replace(/^chess\//, '') }, props: { lesson } }));
}

const { lesson } = Astro.props as { lesson: LessonEntry };
---

<Base title={lesson.data.title} description={lesson.data.summary} schema={lessonSchema(lesson)} wide>
  <LessonShell {lesson}>
    <p class="label" slot="crumb">
      <a href="/chess/">Chess</a> · Stage {lesson.data.stage}: {STAGES[lesson.data.stage]}
    </p>
  </LessonShell>
</Base>

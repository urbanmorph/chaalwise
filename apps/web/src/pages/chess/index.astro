---
import Base from '../../layouts/Base.astro';
import LessonList from '../../components/LessonList.astro';
import { lessonPath, STAGES } from '../../lib/lessons';

// The whole path: chess lessons, with strategy lessons where they fall.
const lessons = await lessonPath();
---

<Base title="Chess" description="Chess lessons, from setting up the board to confident full games.">
  <div class="wrap">
    <h1>Chess</h1>
    <p>From first moves to confident full games. Each lesson is one idea, and its questions come back for review on later days.</p>
    <p>
      Never played? Start with <a href="/chess/first-moves/">your first moves</a>: five minutes against a gentle bot, each rule explained as it comes up.
    </p>
    <p>
      <a href="/chess/drills/">Daily drills</a>: find the square, and is this move safe? A few minutes a day.
    </p>
    <LessonList {lessons} stageNames={STAGES} />
  </div>
</Base>

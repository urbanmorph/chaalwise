---
import { lessonSchema, withContext } from '../../lib/seo';
import { SKILLS } from '@chaalwise/core/skills';
import { getCollection, type CollectionEntry } from 'astro:content';
import LessonShell from '../../components/LessonShell.astro';
import TrackCourse from '../../components/TrackCourse.astro';
import Base from '../../layouts/Base.astro';
import { lessonPath, type LessonEntry } from '../../lib/lessons';

/** Under /skills/: each strategy track's course (`/skills/think-ahead/`) and each strategy lesson (`/skills/blunder-check/`). */
export async function getStaticPaths() {
  const lessons = (await lessonPath())
    .filter((l) => l.data.game === 'strategy')
    .map((lesson) => ({ params: { slug: lesson.id.replace(/^strategy\//, '') }, props: { lesson } }));
  const courses = (await getCollection('tracks')).map((course) => ({ params: { slug: course.id }, props: { course } }));
  return [...lessons, ...courses];
}

const { lesson, course } = Astro.props as { lesson?: LessonEntry; course?: CollectionEntry<'tracks'> };
---

{lesson ? (
  <Base title={lesson.data.title} description={withContext(lesson.data.summary, 'A free strategy lesson.')} schema={lessonSchema(lesson)} wide>
    <LessonShell {lesson}>
      <p class="label" slot="crumb">
        <a href="/skills/">Strategy</a> ·{' '}
        {lesson.data.skills.map((s, i) => (
          <>
            <a href={`/skills/${s}/`}>{SKILLS[s]}</a>
            {i < lesson.data.skills.length - 1 && ' · '}
          </>
        ))}
      </p>
    </LessonShell>
  </Base>
) : (
  <Base title={SKILLS[course!.id as keyof typeof SKILLS]} description={course!.data.idea}>
    <TrackCourse course={course!} />
  </Base>
)}

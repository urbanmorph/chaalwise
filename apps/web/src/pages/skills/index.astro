---
import { SKILLS, type SkillId } from '@chaalwise/core/skills';
import Base from '../../layouts/Base.astro';
import { lessonHref, lessonPath, STAGES } from '../../lib/lessons';
import { COMES_WITH, PLANNED } from '../../lib/planned-skills';

const built = (await lessonPath()).filter((l) => l.data.game === 'strategy');
const tracks = (Object.keys(SKILLS) as SkillId[]).map((id) => ({
  id,
  name: SKILLS[id],
  lessons: PLANNED.filter((p) => p.skill === id).map((p) => ({ ...p, lesson: built.find((l) => l.data.title === p.title) })),
  comesWith: COMES_WITH[id],
}));
---

<Base title="Skills" description="The strategy skills Chaalwise trains, each learned in a game and then shown off the board.">
  <div class="wrap">
    <h1>Skills</h1>
    <p>
      Each skill is learned in a game, then shown off the board: where it turns up in ordinary life, and one way to try it this week. Chess builds thinking
      ahead, calculating, planning, sizing the risk and keeping a cool head; poker and the game-theory labs build the rest.
    </p>
    {tracks.map((track) => (
      <section>
        <h2>{track.name}</h2>
        {track.lessons.length > 0 && (
          <ul class="lessons">
            {track.lessons.map(({ title, stage, lesson }) => (
              <li class:list={['card', { planned: !lesson }]}>
                {lesson ? <a href={lessonHref(lesson)}>{title}</a> : <span class="title">{title}</span>}
                <p class="label">{lesson ? `Chess · stage ${stage}` : `Coming in chess stage ${stage}: ${STAGES[stage]}`}</p>
                {lesson && <p>{lesson.data.summary}</p>}
              </li>
            ))}
          </ul>
        )}
        {track.comesWith && <p class="soon">Comes with {track.comesWith}.</p>}
      </section>
    ))}
  </div>
</Base>

<style>
  section {
    margin-top: 28px;
  }
  .lessons {
    display: grid;
    gap: 12px;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
  }
  .lessons a,
  .title {
    font-weight: 700;
    font-size: 1.05rem;
  }
  .planned {
    background: var(--paper);
    border-style: dashed;
  }
  .planned .title {
    color: var(--ink-2);
  }
  .lessons p {
    margin: 6px 0 0;
    color: var(--ink-2);
  }
  .soon {
    margin: 10px 0 0;
    color: var(--ink-2);
  }
</style>

---
import { SKILL_IDS, SKILLS } from '@chaalwise/core/skills';
import Base from '../../layouts/Base.astro';
import { lessonHref, lessonsFor, STAGES, trackLessons } from '../../lib/lessons';
import { labHref, LABS } from '../../lib/labs/labs';

const tracks = await Promise.all(
  SKILL_IDS.map(async (id) => ({
    id,
    name: SKILLS[id],
    lessons: await trackLessons(id),
    poker: await lessonsFor('poker', id),
    cases: await lessonsFor('case', id),
    lab: LABS.find((l) => l.track === id),
  })),
);
---

<Base title="Strategy" description="The strategy skills Chaalwise trains, for work, study and life, each shown in a game and practised in minutes.">
  <div class="wrap">
    <h1>Strategy</h1>
    <p>
      Each skill is learned in a game, then shown off the board: where it turns up in ordinary life, and one way to try it this week. Chess builds thinking
      ahead, calculating and planning. The <a href="/labs/">game-theory labs</a> build cooperating, being unpredictable and valuing things. Poker builds
      weighing odds, sizing a risk, reading hidden information and bluffing: <a href="/poker/">the poker lessons</a>.
    </p>
    <p>
      Then put the ideas together: <a href="/cases/">work cases</a> are short stories of three to five linked decisions, at college, in a first job, running a
      team or a business. They need no game.
    </p>
    {tracks.map((track) => (
      <section id={track.id}>
        <h2>
          <a href={`/skills/${track.id}/`}>{track.name}</a>
        </h2>
        {track.lessons.length > 0 && (
          <ul class="lessons">
            {track.lessons.map(({ title, stage, lesson }) => (
              <li class:list={['card', { planned: !lesson }]}>
                {lesson ? <a href={lessonHref(lesson)}>{title}</a> : <span class="title">{title}</span>}
                <p class="label">{lesson ? `Chess · stage ${stage}` : `Coming in chess stage ${stage}: ${STAGES[stage]}`}</p>
                {lesson && <p>{lesson.data.summary}</p>}
              </li>
            ))}
          </ul>
        )}
        {track.lab && (
          <p>
            Play it out: <a href={labHref(track.lab)}>the {track.lab.title} lab</a>.
          </p>
        )}
        {track.poker.length > 0 && (
          <p>
            Practise it in poker:{' '}
            {track.poker.map((l, i) => (
              <>
                <a href={lessonHref(l)}>{l.data.title}</a>
                {i < track.poker.length - 1 && ', '}
              </>
            ))}
            .
          </p>
        )}
        {track.cases.length > 0 && (
          <p>
            Use it in a work case:{' '}
            {track.cases.map((l, i) => (
              <>
                <a href={lessonHref(l)}>{l.data.title}</a>
                {i < track.cases.length - 1 && ', '}
              </>
            ))}
            .
          </p>
        )}
      </section>
    ))}
  </div>
</Base>

<style>
  section {
    margin-top: 28px;
  }
  .lessons {
    display: grid;
    gap: 12px;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
  }
  .lessons a,
  .title {
    font-weight: 700;
    font-size: 1.05rem;
  }
  .planned {
    background: var(--paper);
    border-style: dashed;
  }
  .planned .title {
    color: var(--ink-2);
  }
  .lessons p {
    margin: 6px 0 0;
    color: var(--ink-2);
  }
  .soon {
    margin: 10px 0 0;
    color: var(--ink-2);
  }
</style>

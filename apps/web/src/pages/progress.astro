---
import ProgressPanel from '../components/ProgressPanel.svelte';
import SkillProfile from '../components/SkillProfile.svelte';
import Base from '../layouts/Base.astro';
import { fitsBank } from '../lib/fits-bank';
import { settingOf } from '../lib/calibration-round';
import { labIndex, LABS } from '../lib/labs/labs';
import { reviewSteps } from '../lib/lessons';

// Every review card and the setting it is in; the situations of "Which idea fits?" are all from life.
const labs = labIndex();
const settings = {
  ...Object.fromEntries(Object.entries(await reviewSteps()).map(([id, step]) => [id, settingOf(id, step, labs)])),
  ...Object.fromEntries(Object.keys((await fitsBank()).items).map((id) => [id, 'life' as const])),
};
const cardIds = Object.keys(settings);
// The labs as data, so the dashboard's script carries no list of every lab.
const played = LABS.map(({ slug, title }) => ({ slug, title }));
---

<Base title="Progress" description="Your skill profile and progress, kept on this device." noindex>
  <div class="wrap">
    <h1>Your progress</h1>
    <SkillProfile client:load {settings} />
    <h2 class="device">Your progress on this device</h2>
    <ProgressPanel client:load {cardIds} labs={played} />
  </div>
</Base>

<style>
  .device {
    margin-top: 40px;
  }
</style>

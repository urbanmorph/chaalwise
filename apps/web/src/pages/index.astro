---
import Diagram from '../components/Diagram.astro';
import NextFocus from '../components/NextFocus.astro';
import PlayingCard from '../components/poker/PlayingCard.svelte';
import Base from '../layouts/Base.astro';
import { HERO } from '../lib/diagram';
import { SITE_SCHEMA } from '../lib/seo';
import { bestIn, TRACKS } from '../lib/skill-tracks';

// The skills, each under the game that trains it best: that game is where its practice is.
const GAMES = [
  { id: 'chess', title: 'Chess', href: '/chess/', trains: 'Looking ahead, and planning' },
  { id: 'poker', title: 'Poker', href: '/poker/', trains: 'Odds, risk and reading people' },
  { id: 'labs', title: 'Game-theory labs', href: '/labs/', trains: 'Trust, bargaining and bidding' },
] as const;
---

<Base title="Learn strategy through chess and poker" schema={SITE_SCHEMA}>
  <section class="hero wrap">
    <div class="pitch">
      <h1>Think a move ahead.</h1>
      <p class="lead">Short, free lessons in strategy. Each idea is shown in chess or poker, then used at work and in study.</p>
      <NextFocus />
      <p class="who">
        For people who run teams, people who want to, and students: <a href="/start/">where to start</a>. Free and offline: no account, no ads, no money.
      </p>
    </div>

    <div class="one-idea" aria-labelledby="one-idea-title">
      <p id="one-idea-title" class="idea">
        Before you act, ask how the other side will answer.
      </p>
      <figure class="idea-board">
        <Diagram
          fen={HERO.fen}
          move={HERO.move}
          highlight={HERO.attacked}
          label="A chess position: White's knight jumps from d5 to c7, attacking Black's king on e8 and rook on a8 at once."
        />
        <figcaption>
          <strong>In chess</strong> Black must save the king, and the rook falls.
        </figcaption>
      </figure>
      <div class="setting">
        <div class="hands" aria-label="Your cards: ace of spades and king of diamonds. Theirs: face down.">
          <PlayingCard card="As" />
          <PlayingCard card="Kd" />
          <span class="vs">against</span>
          <PlayingCard />
          <PlayingCard />
        </div>
        <p>
          <strong>In poker</strong> You bet. Who calls this, and with what?
        </p>
      </div>
      <div class="setting">
        <p class="note">“Our final offer is ₹40 lakh, valid until Friday.”</p>
        <p>
          <strong>At work</strong> Before you send it: what will they say back?
        </p>
      </div>
    </div>
  </section>

  <section class="wrap skills" id="skills" aria-labelledby="skills-title">
    <h2 id="skills-title">Eleven skills, three places to practise them</h2>
    <div class="games">
      {GAMES.map((game) => (
        <section class="game" data-game={game.id}>
          <h3>
            <a href={game.href}>{game.title}</a>
          </h3>
          <p class="trains">{game.trains}</p>
          <ul>
            {TRACKS.filter((t) => bestIn(t) === game.id).map((track) => (
              <li data-track={track.id}>
                <a href={`/skills/${track.id}/`}>{track.name}</a>
                <span>{track.inLife}</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>

  <section class="wrap how" aria-labelledby="how-title">
    <h2 id="how-title">How it works</h2>
    <ol>
      <li>
        <strong>Learn the idea</strong> A five-minute lesson names it.
      </li>
      <li>
        <strong>See it in a game</strong> Chess, poker or a lab, against the computer. Then <a href="/play-elsewhere/">play it anywhere</a>.
      </li>
      <li>
        <strong>Use it</strong> On a decision of your own, at work or in study.
      </li>
      <li>
        <strong>Bring it back</strong> Just before you would forget it.
      </li>
    </ol>
    <p class="why">
      Playing games on its own does little for general thinking. An idea is more likely to carry over when it is named and practised on your own decisions, so
      every lesson does both: <a href="/transfer/">does this transfer?</a> Your progress stays on this device.
    </p>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    gap: 40px 56px;
    align-items: center;
    padding-block: 32px 24px;
  }
  @media (min-width: 820px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 400px);
      padding-block: 64px 40px;
    }
  }
  h1 {
    font-size: clamp(2.8rem, 7vw, 4.4rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    margin-bottom: 20px;
  }
  .lead {
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
    line-height: 1.5;
    color: var(--ink-2);
    margin: 0;
  }
  .who {
    margin-top: 20px;
    color: var(--ink-2);
    font-size: 0.95rem;
  }

  /* The one bold thing on the page: an idea on the felt, in three settings. */
  .one-idea {
    display: grid;
    gap: 18px;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--felt);
    color: var(--on-felt);
  }
  .idea {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .one-idea p,
  figcaption {
    margin: 0;
    color: var(--on-felt-2);
    font-size: 0.95rem;
  }
  .one-idea strong {
    display: block;
    color: var(--accent);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
  }
  .one-idea .idea {
    color: var(--on-felt);
  }
  .idea-board {
    display: grid;
    grid-template-columns: 132px 1fr;
    gap: 16px;
    align-items: center;
    margin: 0;
  }
  .setting {
    display: grid;
    gap: 8px;
    padding-top: 16px;
    border-top: 1px solid rgb(255 255 255 / 0.16);
  }
  .hands {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .hands :global(.playing-card) {
    width: 2.4rem;
    height: 3.3rem;
    border-color: transparent;
  }
  .hands :global(.playing-card.back) {
    border-color: rgb(255 255 255 / 0.3);
  }
  .hands :global(.rank),
  .hands :global(.suit) {
    font-size: 1.05rem;
  }
  .vs {
    margin-inline: 6px;
    color: var(--on-felt-2);
    font-size: 0.85rem;
  }
  .one-idea .note {
    padding: 10px 14px;
    border-radius: 8px;
    background: rgb(255 255 255 / 0.08);
    color: var(--on-felt);
    font-style: italic;
  }

  .skills,
  .how {
    margin-top: 72px;
  }
  .games {
    display: grid;
    gap: 32px;
    margin-top: 24px;
  }
  @media (min-width: 820px) {
    .games {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .game {
    border-top: 3px solid var(--felt-2);
    padding-top: 14px;
  }
  .game h3 {
    margin: 0;
    font-size: 1.3rem;
  }
  .game h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  .game h3 a:hover {
    text-decoration: underline;
  }
  .trains {
    color: var(--ink-2);
    margin: 2px 0 14px;
  }
  .game ul {
    display: grid;
    gap: 14px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .game li a {
    display: block;
    font-weight: 700;
  }
  .game li span {
    display: block;
    color: var(--ink-2);
    font-size: 0.92rem;
    line-height: 1.45;
  }

  .how ol {
    display: grid;
    gap: 20px 28px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    padding: 0;
    margin: 20px 0 24px;
    list-style: none;
    counter-reset: step;
  }
  .how li {
    counter-increment: step;
    color: var(--ink-2);
  }
  .how li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-bottom: 10px;
    border-radius: 50%;
    background: var(--felt-2);
    color: var(--on-felt);
    font-weight: 800;
  }
  .how li strong {
    display: block;
    color: var(--ink);
  }
  .why {
    color: var(--ink-2);
    font-size: 0.95rem;
  }
</style>

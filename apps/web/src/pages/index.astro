---
import { SKILLS } from '@chaalwise/core/skills';
import Base from '../layouts/Base.astro';
import { lessonHref, lessonPath } from '../lib/lessons';

const [first] = await lessonPath();
---

<Base title="Chaalwise">
  <section class="hero">
    <div class="wrap">
      <p class="label kicker">Strategy, learned through games</p>
      <h1>Think a move ahead.</h1>
      <p class="lead">
        A strategy gym where games are the equipment. Learn to think ahead, calculate, weigh odds and plan, through chess now and poker next, against the
        computer. Free, offline, no ratings.
      </p>
      <div class="actions">
        {first && (
          <a class="button primary" href={lessonHref(first)}>
            Start the first lesson
          </a>
        )}
        <a class="button" href="/review/">
          Today's review
        </a>
        <a class="button" href="/chess/drills/">
          Daily drills
        </a>
      </div>
    </div>
  </section>

  <section class="wrap two">
    <div class="card">
      <p class="label">Chess · now</p>
      <h2>Think when you can see everything.</h2>
      <p>From setting up the board to confident full games, one idea per lesson.</p>
      <a href="/chess/">Chess lessons</a>
    </div>
    <div class="card felt">
      <p class="label">Poker · next</p>
      <h2>Decide when you can't.</h2>
      <p>The maths and the choices, from zero, with practice points that are free and never for sale.</p>
    </div>
  </section>

  <section class="wrap">
    <h2>The skills you train</h2>
    <ul class="skills">
      {Object.values(SKILLS).map((name) => (
        <li>{name}</li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .hero {
    padding-block: 24px 40px;
  }
  .kicker {
    color: var(--accent-text);
  }
  h1 {
    font-size: clamp(2.4rem, 6vw, 3.5rem);
    line-height: 1.05;
  }
  .lead {
    font-size: 1.2rem;
    color: var(--ink-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }
  .two {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    margin-bottom: 48px;
  }
  .felt {
    background: var(--felt);
    border-color: var(--felt);
    color: var(--on-felt);
  }
  .felt .label,
  .felt p {
    color: var(--on-felt-2);
  }
  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 0;
    list-style: none;
  }
  .skills li {
    padding: 6px 14px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--card);
  }
</style>

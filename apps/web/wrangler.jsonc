{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static assets only: no Worker code. The account comes from CLOUDFLARE_ACCOUNT_ID
  // (the UrbanMorph account), set explicitly in .env or CI, never the ambient login.
  "name": "chaalwise",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "chaalwise.urbanmorph.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
}

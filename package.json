{
  "name": "chaalwise",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @chaalwise/web dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @chaalwise/web test:e2e",
    "budget": "pnpm --filter @chaalwise/web budget",
    "ship": "pnpm build && node scripts/deploy.mjs"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "prettier-plugin-svelte": "4.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}

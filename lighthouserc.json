{
  "ci": {
    "collect": {
      "staticDistDir": "apps/web/dist",
      "url": [
        "http://localhost/",
        "http://localhost/chess/",
        "http://localhost/chess/board/",
        "http://localhost/chess/drills/",
        "http://localhost/progress/",
        "http://localhost/reference/",
        "http://localhost/reference/chess/kings-indian-defence/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "simulate"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
